{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------------------
  // opencode-autodl config template (JSONC).
  //
  // This template is only used when NO config exists yet. An existing config is
  // never clobbered; apply the DeepSeek defaults to an existing config with:
  //     OPENCODE_PRESET=deepseek ./setup.sh      (or ./setup.sh --preset deepseek)
  //
  // Default model: deepseek/deepseek-flash (DeepSeek-V4.1-Flash) with maximum
  // reasoning effort. The API key is NOT stored here. Provide it with
  // `opencode auth login`, the DEEPSEEK_API_KEY environment variable, or
  // OPENCODE_API_KEY_ENV (see config/autodl.example.env and
  // examples/providers.example.jsonc).
  //
  // Comments are stripped when this file is normalized into opencode.json.
  // ---------------------------------------------------------------------------
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",

  "provider": {
    "deepseek": {
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "options": { "reasoningEffort": "max" }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "options": { "reasoningEffort": "max" }
        }
      }
    }
  }
}
