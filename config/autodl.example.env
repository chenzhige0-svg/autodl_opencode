# opencode-autodl example environment
#
# Copy the values you need into your shell (e.g. ~/.bashrc) or export them
# before running ./setup.sh. Never commit real credentials.

# --- install behaviour -----------------------------------------------------
# Install method: curl (default, no Node.js needed) | npm | bun | pnpm | auto
OPENCODE_INSTALL_METHOD=curl

# Pin a specific OpenCode version instead of latest (optional)
# OPENCODE_INSTALL_VERSION=1.0.180

# --- persistence -----------------------------------------------------------
# auto (default) | fs | tmp | path | none
#   fs   -> /root/autodl-fs   (cross-instance file storage, same region)
#   tmp  -> /root/autodl-tmp  (instance data disk)
#   path -> use OPENCODE_PERSIST_DIR
OPENCODE_PERSIST_MODE=auto
# OPENCODE_PERSIST_DIR=/root/autodl-fs/opencode-persist

# --- config generation (only applied when set) -----------------------------
# Apply a non-secret preset from config/presets/<name>.jsonc.
# "deepseek" is provided and sets the default model to
# deepseek/deepseek-flash (DeepSeek-V4.1-Flash) with reasoningEffort=max
# ("4.1 flash max").
# Equivalent command-line form: ./setup.sh --preset deepseek
OPENCODE_PRESET=deepseek

# Optional explicit overrides (these win over the preset).
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_SMALL_MODEL=anthropic/claude-haiku-4-5
# OPENCODE_PROVIDER=anthropic
# OPENCODE_BASE_URL=https://api.anthropic.com/v1
# Name of the env var that holds the API key (referenced as {env:...}).
# OPENCODE_API_KEY_ENV=ANTHROPIC_API_KEY
# OPENCODE_AUTOUPDATE=false

# --- DeepSeek credentials --------------------------------------------------
# The key is never written into the repo. Either authenticate once with
#   opencode auth login        # writes ~/.local/share/opencode/auth.json
# or export it in the shell (referenced by the config as {env:DEEPSEEK_API_KEY}):
# export DEEPSEEK_API_KEY=sk-...

# --- network ---------------------------------------------------------------
# If GitHub is slow in your region (AutoDL mainland China), run:
#   source /etc/network_turbo
# or set a proxy explicitly (NO_PROXY must include localhost,127.0.0.1):
# export HTTPS_PROXY=http://127.0.0.1:7890
# export HTTP_PROXY=http://127.0.0.1:7890
# export NO_PROXY=localhost,127.0.0.1

# --- optional live verification (may incur provider cost) ------------------
# OPENCODE_LIVE_TEST=1
